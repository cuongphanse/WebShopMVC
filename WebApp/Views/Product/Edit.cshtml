@model Product

<form enctype="multipart/form-data" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    
    <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />
    <div class="row mb-1">
        <label class="form-labe col-2" for="categoryId">Category</label>
        <div class="col-10">
            <select name="categoryId" id="categoryId">
                @foreach(Category item in ViewBag.categories){
                    <option value="@item.Id" selected= "@(item.Id == Model.CategoryId ? "selected" : null)">@item.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="row mb-1">
        <label class="form-labe col-2" for="name">Name</label>
        <div class="col-10">
            <input class ="form-control" type="text" value="@Model.Name" id="name" name="name" />
        </div>
    </div>
     <div class="row mb-1">
        <label class="form-label col-2" for="price">Price</label>
        <div class="col-10">
            <input class ="form-control" type="number" value="@Model.Price" step="0.01" id="price" name="price" />
        </div>
    </div>
    <div class="row mb-1">
        <label class="form-label col-2" for="quantity">Quantity</label>
        <div class="col-10">
            <input class ="form-control" type="number" value="@Model.Quantity" id="quantity" name="quantity" />
        </div>
    </div>
    <div class="row mb-1">
       <label class="form-label col-2" for="saleOff">SaleOff</label>
        <div class="col-10">
            <input class ="form-control" type="number" value="@Model.SaleOff" step="0.01" id="saleOff" name="saleOff" />
        </div>
    </div>
     <div class="row mb-1 align-items-center">
        <label class="form-label col-2" for="f">Image</label>
        <div class="col-1">
            <img src="/images/@Model.ImageUrl" width="100" alt="">
        </div>
        <div class="col-9">
            <input class ="form-control" type="file" id="f" name="f" accept="image/*"/>
        </div>
    </div>
     <div class="row mb-1">
        <label class="form-label col-2" for="description">Description</label>
        <div class="col-10">
            <textarea class="form-control" id="description" name="description">@Model.Description</textarea>
        </div>
    </div>
     <div class="row mb-1">
        <label class="form-label col-2" for="content">Content</label>
        <div class="col-10">
            <input class ="form-control" type="text" value="@Model.Content" id="content" name="content" />
        </div>
    </div>
    <div class="offset-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/product" class="btn btn-outline-primary">Cancel</a>
    </div>
</form>